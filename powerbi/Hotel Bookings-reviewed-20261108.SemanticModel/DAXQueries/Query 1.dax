EVALUATE ROW("Rows",COUNTROWS(hotel_bookings),"CountryKeys",COUNTROWS(Country),"DistinctKeys",DISTINCTCOUNT(Country[country]),"BlankLabels",COUNTROWS(FILTER(Country,ISBLANK(Country[Name]))),"MissingCountryBookings",CALCULATE([Number of Bookings],Country[Name]="Not recorded"),"CalendarRows",COUNTROWS('Calendar'),"CalendarKeys",DISTINCTCOUNT('Calendar'[Date]),"OrphanDates",COUNTROWS(EXCEPT(VALUES(hotel_bookings[ArrivalDate]),VALUES('Calendar'[Date]))))